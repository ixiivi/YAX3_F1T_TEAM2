diff --git a/vesc_ackermann/src/ackermann_to_vesc.cpp b/vesc_ackermann/src/ackermann_to_vesc.cpp
index 79863f8..0ff031c 100644
--- a/vesc_ackermann/src/ackermann_to_vesc.cpp
+++ b/vesc_ackermann/src/ackermann_to_vesc.cpp
@@ -54,10 +54,13 @@ AckermannToVesc::AckermannToVesc(const rclcpp::NodeOptions & options)
     declare_parameter<double>("steering_angle_to_servo_gain");
   steering_to_servo_offset_ =
     declare_parameter<double>("steering_angle_to_servo_offset");
+  brake_below_speed_ = declare_parameter<double>("brake_below_speed", 0.0);
+  stop_brake_current_ = declare_parameter<double>("stop_brake_current", 0.0);
 
   // create publishers to vesc electric-RPM (speed) and servo commands
   erpm_pub_ = create_publisher<Float64>("commands/motor/speed", 10);
   servo_pub_ = create_publisher<Float64>("commands/servo/position", 10);
+  brake_pub_ = create_publisher<Float64>("commands/motor/brake", 10);
 
   // subscribe to ackermann topic
   ackermann_sub_ = create_subscription<AckermannDriveStamped>(
@@ -76,7 +79,15 @@ void AckermannToVesc::ackermannCmdCallback(const AckermannDriveStamped::SharedPt
 
   // publish
   if (rclcpp::ok()) {
-    erpm_pub_->publish(erpm_msg);
+    // sensorless speed control near zero ERPM overshoots and kicks the wheels backwards,
+    // so hold the motor with brake current instead
+    if (std::fabs(cmd->drive.speed) < brake_below_speed_) {
+      Float64 brake_msg;
+      brake_msg.data = stop_brake_current_;
+      brake_pub_->publish(brake_msg);
+    } else {
+      erpm_pub_->publish(erpm_msg);
+    }
     servo_pub_->publish(servo_msg);
   }
 }
